{
  "name": "@haneoka/cassiopeia",
  "version": "0.1.0",
  "description": "Portable rhythm-game runtime with an Our Notes compatible web renderer",
  "keywords": [
    "rhythm-game",
    "chart",
    "three.js",
    "vue"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/cassiopeia.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/cassiopeia/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/cassiopeia#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/CASSIOPEIA_CHART_FORMAT.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets-entry.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./overview": {
      "types": "./dist/overview-entry.d.ts",
      "import": "./dist/overview.js",
      "default": "./dist/overview.js"
    },
    "./parser": {
      "types": "./dist/parser-entry.d.ts",
      "import": "./dist/parser.js",
      "default": "./dist/parser.js"
    },
    "./player": {
      "types": "./dist/player-entry.d.ts",
      "import": "./dist/player.js",
      "default": "./dist/player.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "benchmark": "pnpm run build && node benchmarks/runtime.mjs && node benchmarks/effects.mjs",
    "test:runtime": "pnpm run build && node tests/runtime-trace.mjs && node tests/title-introduction.mjs && node tests/hud-presentation.mjs && node tests/background-media.mjs && node tests/particle-emission.mjs && node tests/note-mark.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "check": "pnpm run typecheck && pnpm run test:runtime && pnpm run rust:check && pnpm run rust:test",
    "prepack": "pnpm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "peerDependencies": {
    "three": ">=0.184.0 <0.185.0",
    "vue": ">=3.5.0 <4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "three": "0.184.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vue": "3.5.39",
    "vue-tsc": "^3.3.6"
  }
}
